APP_NAME="Stores Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stores_laravel
DB_USERNAME=root
DB_PASSWORD=

# Read-only legacy source database (never modified by this app)
DB_LEGACY_DATABASE=stores

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="stores@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Nightly db:backup (schedule in routes/console.php, 02:00). For the
# off-site requirement set BACKUP_DIR to a second disk or network share;
# empty = storage/backups (same-disk fallback, NOT off-site).
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_MYSQLDUMP=C:/xampp/mysql/bin/mysqldump.exe
